# ============================================
# Job Matcher ML Service - Configuration
# ============================================
# Copy this file to .env and modify as needed
# All values shown are defaults

# --- API Settings ---
APP_NAME=Job Matcher ML Service
APP_VERSION=1.1.0
DEBUG=true
HOST=0.0.0.0
PORT=5000

# --- Logging Settings ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log detailed scoring breakdown for each match
LOG_SCORING_DETAILS=true

# Log embedding vectors (very verbose, use for debugging only)
LOG_EMBEDDINGS=false

# Log format
LOG_FORMAT=%(asctime)s [%(levelname)s] %(name)s: %(message)s

# --- Model Settings ---
# Embedding model (sentence-transformers)
# Options: all-MiniLM-L6-v2 (fast), all-mpnet-base-v2 (better quality)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# spaCy model (optional, falls back to basic processing if not installed)
SPACY_MODEL=en_core_web_sm

# --- Scoring Weights (must sum to 1.0) ---
WEIGHT_SKILL_MATCH=0.50
WEIGHT_EXPERIENCE_MATCH=0.25
WEIGHT_SEMANTIC_MATCH=0.15
WEIGHT_REQUIREMENTS_FIT=0.10

# --- Scoring Penalties & Caps ---
# Maximum score if NO skills match at all
ZERO_SKILL_MATCH_CAP=45

# If skill score is below this threshold (0.0-1.0), penalize experience
LOW_SKILL_THRESHOLD=0.30

# Multiply experience score by this if skills are low
LOW_SKILL_EXPERIENCE_PENALTY=0.5

# --- Recommendation Thresholds ---
THRESHOLD_STRONG_APPLY=80
THRESHOLD_GOOD_FIT=65
THRESHOLD_MAYBE=50
# Below THRESHOLD_MAYBE = WEAK_MATCH

# --- Storage Settings ---
# Options: memory, opensearch
STORAGE_BACKEND=memory

# OpenSearch settings (only used if STORAGE_BACKEND=opensearch)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
